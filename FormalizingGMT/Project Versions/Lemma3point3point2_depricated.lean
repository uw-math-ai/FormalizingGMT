    (E : Set X) (s : ℝ) (hs : 0 ≤ s)
    (h_null : ∀ k : ℕ, hausdorffMeasure s (E_set E s (1 / (k + 1 : ℝ)) (1 - 1 / (k + 1 : ℝ))) = 0) :
