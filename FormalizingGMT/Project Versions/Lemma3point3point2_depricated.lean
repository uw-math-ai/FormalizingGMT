      exact ⟨ MeasureTheory.measure_mono <| Set.inter_subset_inter h_subset <| Set.Subset.refl _, if hC_diam_pos : 0 < ( EMetric.diam C |> ENNReal.toReal ) then h_density _ hC_diam_pos ( by
